{
  "name": "agarthan-armory",
  "version": "1.0.0",
  "private": true,
  "description": "Agarthan Armory storefront (static site) + the catalog scraper that keeps it in sync with the live store.",
  "scripts": {
    "start": "node scripts/boot.mjs",
    "probe": "node scripts/probe-site.mjs https://agarthanarmory.com",
    "scrape": "node scripts/scrape.mjs --site https://agarthanarmory.com",
    "scrape:shop": "node scripts/scrape.mjs --site https://shop.agarthanarmory.com --out assets/data/scraped/shop --max-images 0",
    "build:catalog": "node scripts/build-catalog.mjs",
    "sync": "npm run scrape && npm run build:catalog",
    "test": "node scripts/test-scrape.mjs && node scripts/test-images.mjs && node scripts/test-facets.mjs && node scripts/test-realm-art.mjs && node scripts/test-ops.mjs",
    "test:ops-ui": "node scripts/test-ops-ui.mjs",
    "build:wall": "node tools/build-wall.mjs",
    "build:icons": "node tools/build-icons.mjs",
    "stamp": "node tools/stamp-partials.mjs",
    "films": "node tools/trailer/render.mjs",
    "films:sound": "node tools/trailer/sound/score.mjs && node tools/trailer/sound/soundtrack.mjs",
    "films:trailer": "node tools/trailer/trailer.mjs",
    "films:check": "node tools/trailer/flash-check.mjs media/films/*.mp4",
    "images": "node scripts/match-images.mjs",
    "find-images": "node scripts/find-images.mjs",
    "save-pages": "node scripts/save-pages.mjs",
    "theme:test": "php woocommerce/tools/test-theme.php && node woocommerce/tools/skin-audit.mjs --out .skin-audit",
    "theme:holo": "node woocommerce/tools/build-holo.mjs",
    "theme:pack": "node woocommerce/tools/skin-audit.mjs --theme-shot --out .skin-audit && node woocommerce/tools/pack.mjs"
  },
  "engines": {
    "node": ">=18"
  }
}
